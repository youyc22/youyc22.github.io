---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ "/" | absolute_url }}</loc>
  </url>
  <url>
    <loc>{{ "/about/" | absolute_url }}</loc>
  </url>
  <url>
    <loc>{{ "/projects/" | absolute_url }}</loc>
  </url>
  <url>
    <loc>{{ "/honors/" | absolute_url }}</loc>
  </url>
  {% assign form_id = site.formspree_form_id | default: "" %}
  {% if form_id != "" %}
  <url>
    <loc>{{ "/message/" | absolute_url }}</loc>
  </url>
  {% endif %}
</urlset>
